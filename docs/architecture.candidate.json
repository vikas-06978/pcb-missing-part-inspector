  "cards": [
    {
      "dot": "cyan",
      "title": "Offline by construction",
      "items": [
        "Server binds 127.0.0.1 and makes no outbound request",
        "No CDN script, web font or external stylesheet",
        "Photos stay in data/ on this machine"
      ]
    },
    {
      "dot": "emerald",
      "title": "Engine isolation",
      "items": [
        "app/vision imports only cv2, numpy and app.config",
        "So the harness runs it with no server and no HTTP",
        "Every number that decides a verdict lives in app/config.py"
      ]
    },
    {
      "dot": "violet",
      "title": "Measured, not asserted",
      "items": [
        "80 boards x 24 named parts = 1,920 part decisions",
        "100% precision and recall at default sensitivity",
        "Benchmark boards are rendered, not photographed"
      ]
    }
  ]
